<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installing a downloaded update; Android asks the user to allow it the first time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Reloaded"
        android:allowBackup="true"
        android:supportsRtl="true">

        <!-- The launcher UI (Jetpack Compose, Material 3 Expressive). It handles orientation changes
             itself, so the controls editor can turn the screen sideways without being recreated. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Rust emulator. It takes the native window itself (android_main).
             Landscape is asked for here, in the manifest, and not from Kotlin: the game lays its
             screens out from the size of the window it is given, so if the activity started in
             portrait and rotated later, those first screens stayed built for a portrait window.
             The bars are a different matter: they are hidden from Kotlin once the game is running,
             so during loading the status bar still shows. -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode"
            android:theme="@style/Theme.Reloaded.Game">
            <meta-data
                android:name="android.app.lib_name"
                android:value="gm8emulator" />
        </activity>

        <!-- Hands the downloaded APK to the system installer, which takes a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
