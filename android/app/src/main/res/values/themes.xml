<resources>
    <!-- Compose draws everything; this only removes the action bar and lets the app go edge to edge. -->
    <style name="Theme.Reloaded" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- The emulator's window is opaque and black. It used to be transparent so the launcher showed
         through while the engine loaded, but that showed the launcher's own screen through the game
         (and turned with it), which read as broken. A plain black window while it loads is quiet and
         honest.

         It is deliberately NOT fullscreen either: the status bar stays until the engine says it is
         really running, and the bars are hidden from Kotlin only then. -->
    <style name="Theme.Reloaded.Game" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
